# Copy to backend/.env for local development. NEVER commit a real .env.
APP_ENV=development            # development | testing | production
SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-64
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false            # must be true in production (HTTPS)
CORS_ORIGINS=http://localhost:8000

# Local dev uses SQLite. For SQL Server (least-privilege login, encrypted connection):
# DATABASE_URL=mssql+pyodbc://sd_app:<password>@sqlserver-host:1433/ServiceDesk?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL=sqlite:///./servicedesk_dev.db

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
APP_TIMEZONE=Asia/Kolkata
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Email stays OFF until the company SMTP relay is configured AND tested
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=it-servicedesk@yourcompany.example
SMTP_STARTTLS=true

# Demo seed only (development)
DEMO_PASSWORD=Vision@Demo2026
